# Applies to everything, including the walkthroughs and the 404 page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Asset filenames are NOT content-hashed, so a long immutable cache would
# strand viewers on an old image after a redeploy. One day is the compromise.
/assets/*
  Cache-Control: public, max-age=86400

/walkthroughs/*
  Cache-Control: public, max-age=86400
