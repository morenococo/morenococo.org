# Applies to everything, including the walkthroughs and the 404 page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Asset filenames are NOT content-hashed, so a cached copy can only be
# replaced by waiting out its max-age. That is fine for the media, which is
# large and effectively immutable once published, but NOT for the CSS and JS:
# a day of staleness there means a deployed fix does not reach a returning
# visitor, and the edge keeps serving the old file at its bare URL too.
#
# These two rules are NOT redundant. Cloudflare Pages' own default for static
# assets is `public, max-age=86400` (measured on a genuine cf-cache-status
# MISS); only HTML defaults to must-revalidate. Deleting these lines silently
# restores a one-day cache on the code. Together they are ~23 KB, so
# revalidating on every visit costs a 304 and nothing else.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/img/*
  Cache-Control: public, max-age=86400

/assets/data/*
  Cache-Control: public, max-age=86400

# The CV is republished whenever a paper lands, and people are pointed at this
# exact URL. A day of staleness would hand them the superseded version, so it
# revalidates like the code rather than caching like the media.
/assets/cv.pdf
  Cache-Control: public, max-age=0, must-revalidate

/walkthroughs/*
  Cache-Control: public, max-age=86400
